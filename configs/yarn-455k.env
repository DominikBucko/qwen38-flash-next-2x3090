# Extended-context profile: 455,000-token window via YaRN RoPE rescaling.
# Adds to .env (the served window exceeds the trained 262,144; this is
# training-free YaRN, see docs/long-context.md for what it changes and what
# it does not). Requires the --hf-overrides wiring in scripts/serve-container.sh.

# vLLM accepts windows above the checkpoint's max_position_embeddings only
# with the opt-in flag below.
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

# 455000 = 1.735687255859375 x 262144 exactly; the factor is derived, not tuned.
MAX_MODEL_LEN=455000

# Replace the rope config the checkpoint ships, changing only rope_type, factor
# and original_max_position_embeddings. IMPORTANT: --hf-overrides merges the
# object you give it over the model config, so every other field the model
# relies on (mrope_section, partial_rotary_factor, rope_theta) must be repeated
# here verbatim from config.json; omitting one silently resets it to a default.
HF_OVERRIDES_JSON={"text_config":{"max_position_embeddings":455000,"rope_parameters":{"rope_type":"yarn","factor":1.735687255859375,"original_max_position_embeddings":262144,"attn_factor":1.0,"beta_fast":32,"beta_slow":1,"mrope_interleaved":true,"mrope_section":[11,11,10],"partial_rotary_factor":0.25,"rope_theta":10000000}},"max_position_embeddings":455000}

# KV bytes scale linearly with the window: the stock BF16 pool sized for
# 262,144 (4,429,185,024) needs about 1.74x the memory at 455,000
# (~7.7 GB across both ranks). Two ways to fit it:
#   a) a rig with more total VRAM than 2x RTX 3090: keep BF16 KV and raise
#      KV_CACHE_MEMORY_BYTES to about 7.7e9;
#   b) a quantized KV cache: fp8 halves the pool, so the stock 4.43 GB budget
#      covers 455K with headroom.
KV_CACHE_DTYPE=fp8_per_token_head
# On sm_120 hardware the per-tensor "fp8" cache avoids the per-token-head
# scale-cache traffic; see the companion PR adding it.

# This window doubles nothing else: MAX_NUM_BATCHED_TOKENS, the hot cache and
# the PLE arm are unchanged. Expect slower first-token for very long prompts
# only because the prompt is longer, not because YaRN adds work.
