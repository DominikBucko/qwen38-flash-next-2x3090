# 64 GB profile for 2x RTX 3090 + 64 GB system RAM: 128K context, single request.
# Append to .env (cat configs/2x3090-64gb.env >> .env). See docs/memory.md, "64 GB RAM".
#
# The 128 GB profiles keep a pinned copy of every expert (~58 GiB) plus the PLE table (~48 GiB) in RAM. Here each
# GPU owns its most-used experts outright (QWEN38_HOT_ONLY per layer), the other experts of its half live once in a
# RAM arena (~38 GiB for both GPUs), the CPU computes them during decode while the GPU computes a share over PCIe,
# prefill streams them to the GPUs, and the FP8 PLE table is read in place from the checkpoint on NVMe.

# Experts per layer kept on each GPU (~116 MiB of VRAM each). 88 peaks at ~23.7 GB per GPU with 8K prefill
# chunks; 96 ran out of VRAM in the first prefill. Use 80 if a card also drives a display.
QWEN38_HOT_ONLY=88
# Container memory limit; the expert arenas are sized from it. auto = installed RAM - HOST_RESERVE_GIB.
MEMORY_LIMIT=auto
HOST_RESERVE_GIB=8

MAX_MODEL_LEN=135168
# 110 KV blocks: a full 135,168-token request plus the recurrent-state blocks async prefill holds.
KV_CACHE_MEMORY_BYTES=2500000000
MAX_NUM_BATCHED_TOKENS=8192

# Prefill: cold experts are copied to each GPU in groups of 80; chunks of up to 384 tokens use the CPU instead.
QWEN38_STREAM_GROUP=80
QWEN38_CPU_PREFILL_MAX=384
# Decode: share of each layer's cold experts the GPU computes over PCIe while the CPU works.
QWEN38_GPU_SHARE_FRAC=0.3
# CPU placement: one pool per GPU, derived from the topology (see docs/memory.md).
QWEN38_CPU_EXPERTS_CPUS=auto
QWEN38_MAIN_CPUS=auto

QWEN38_ASYNC_SCHEDULING=1
QWEN38_TRITON_SKINNY=1
VLLM_MTP_DRAFT_VOCAB_RANGES=[[0,65536],[248044,248320]]
# NCCL all-reduce: works without CUDA P2P between the cards (typical for consumer boards).
DISABLE_CUSTOM_ALL_REDUCE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
JIT_CACHE_DIR=./jit-cache
