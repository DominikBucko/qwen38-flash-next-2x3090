# Validated full-256K, single-request profile for 2x RTX 3090 + 128 GiB RAM.
: "${PORT:=8000}"
: "${SERVED_MODEL_NAME:=Qwen3.8-Flash-Next}"
: "${MAX_MODEL_LEN:=262144}"
: "${MAX_NUM_BATCHED_TOKENS:=4096}"
: "${MAX_NUM_SEQS:=1}"
: "${KV_CACHE_MEMORY_BYTES:=4429185024}"
: "${CPU_OFFLOAD_GB:=30}"
: "${VLLM_PLE_OFFLOAD_READY_TIMEOUT:=1200}"
: "${VLLM_WNA16_STATIC_HOT_CACHE_SIZE:=88}"
: "${VLLM_WNA16_STATIC_HOT_CACHE_MAX_TOKENS:=16}"
: "${VLLM_PREFIX_CACHE_RETENTION_INTERVAL:=1600}"
: "${VLLM_QSA_EXACT_TOPK:=0}"
: "${MTP_DEPTH:=3}"

export PORT SERVED_MODEL_NAME MAX_MODEL_LEN MAX_NUM_BATCHED_TOKENS
export MAX_NUM_SEQS KV_CACHE_MEMORY_BYTES CPU_OFFLOAD_GB
export VLLM_PLE_OFFLOAD_READY_TIMEOUT VLLM_WNA16_STATIC_HOT_CACHE_SIZE
export VLLM_WNA16_STATIC_HOT_CACHE_MAX_TOKENS
export VLLM_PREFIX_CACHE_RETENTION_INTERVAL VLLM_QSA_EXACT_TOPK MTP_DEPTH
