# Validated full-256K, single-request profile for 2x RTX 3090 + 128 GiB RAM.
: "${PORT:=8000}"
: "${SERVED_MODEL_NAME:=Qwen3.8-Flash-Next}"
: "${MAX_MODEL_LEN:=262144}"
: "${MAX_NUM_BATCHED_TOKENS:=4096}"
: "${MAX_PARALLEL_LOADING_WORKERS:=1}"
: "${MAX_NUM_SEQS:=1}"
: "${KV_CACHE_MEMORY_BYTES:=4429185024}"
: "${CPU_OFFLOAD_GB:=30}"
: "${VLLM_PLE_OFFLOAD_READY_TIMEOUT:=1200}"
# Leave prefill headroom; 88 is an optional, tighter speed profile.
: "${VLLM_WNA16_STATIC_HOT_CACHE_SIZE:=84}"
: "${VLLM_WNA16_STATIC_HOT_CACHE_MAX_TOKENS:=16}"
: "${VLLM_PREFIX_CACHE_RETENTION_INTERVAL:=1600}"
: "${VLLM_QSA_EXACT_TOPK:=0}"
: "${MTP_DEPTH:=3}"
: "${ENABLE_VISION:=0}"
: "${VISION_MAX_IMAGES:=1}"
: "${VISION_MAX_PIXELS:=1048576}"
# Opt-in fast 256K switches (see configs/fast-256k.env); all off by default.
: "${QWEN38_ASYNC_SCHEDULING:=0}"
: "${QWEN38_STREAM_STAGE:=0}"
: "${QWEN38_STREAM_STAGE_MIN_TOKENS:=3000}"
: "${QWEN38_STAGE_OVERLAP:=0}"
: "${QWEN38_TRITON_SKINNY:=0}"
: "${QWEN38_PLE_PREFAULT:=0}"
: "${VLLM_MTP_DRAFT_VOCAB_RANGES:=}"
# Custom all-reduce requires verified CUDA P2P and an IPC-compatible allocator;
# expandable_segments:True is incompatible with this pinned runtime's graph IPC.
: "${DISABLE_CUSTOM_ALL_REDUCE:=1}"

export PORT SERVED_MODEL_NAME MAX_MODEL_LEN MAX_NUM_BATCHED_TOKENS
export MAX_PARALLEL_LOADING_WORKERS
export MAX_NUM_SEQS KV_CACHE_MEMORY_BYTES CPU_OFFLOAD_GB
export VLLM_PLE_OFFLOAD_READY_TIMEOUT VLLM_WNA16_STATIC_HOT_CACHE_SIZE
export VLLM_WNA16_STATIC_HOT_CACHE_MAX_TOKENS
export VLLM_PREFIX_CACHE_RETENTION_INTERVAL VLLM_QSA_EXACT_TOPK MTP_DEPTH
export DISABLE_CUSTOM_ALL_REDUCE
export ENABLE_VISION VISION_MAX_IMAGES VISION_MAX_PIXELS
export QWEN38_ASYNC_SCHEDULING QWEN38_STREAM_STAGE QWEN38_STREAM_STAGE_MIN_TOKENS
export QWEN38_STAGE_OVERLAP QWEN38_TRITON_SKINNY QWEN38_PLE_PREFAULT
export VLLM_MTP_DRAFT_VOCAB_RANGES
