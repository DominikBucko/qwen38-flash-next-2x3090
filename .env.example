# Absolute host path to the assembled or downloaded Hugging Face model repo.
MODEL_DIR=/models/Qwen3.8-Flash-Next-Intel-W4A16-FP8PLE
PORT=8000
# Set to 1 only for the slower exact-QSA experiment.
VLLM_QSA_EXACT_TOPK=0

# The values below reproduce the benchmark-tight 256K profile. See
# docs/memory.md before changing them; the hot-cache and KV settings compete
# for the same VRAM.
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MAX_PARALLEL_LOADING_WORKERS=1
KV_CACHE_MEMORY_BYTES=4429185024
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=88
