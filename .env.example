# Absolute host path to the assembled or downloaded Hugging Face model repo.
MODEL_DIR=/models/qwen38-flash-next
PORT=8000
# Set to 1 only for the slower exact-QSA experiment.
VLLM_QSA_EXACT_TOPK=0
# Set to 0 only after verifying CUDA P2P and selecting an IPC-compatible
# allocator; the pinned runtime cannot combine custom all-reduce CUDA graphs
# with expandable_segments:True.
DISABLE_CUSTOM_ALL_REDUCE=1
# Keep the existing allocator default. Change this to expandable_segments:False
# before opting into custom all-reduce with the pinned runtime.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# The values below reproduce the benchmark-tight 256K profile. See
# docs/memory.md before changing them; the hot-cache and KV settings compete
# for the same VRAM.
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MAX_PARALLEL_LOADING_WORKERS=1
KV_CACHE_MEMORY_BYTES=4429185024
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=88
